# INO Platform App production environment template
# Copy these values into the deployment environment. Never commit real secrets.

NODE_ENV=production
APP_URL=https://app.indigenousnations.org
AUTH_URL=https://app.indigenousnations.org
NEXTAUTH_URL=https://app.indigenousnations.org
AUTH_TRUST_HOST=true

# Generate strong, unique random values for each secret.
AUTH_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-second-long-random-secret

# Infrastructure
DATABASE_URL=replace-with-your-postgresql-connection-string
REDIS_URL=replace-with-your-redis-connection-string

# WordPress App Bridge
WORDPRESS_BASE_URL=https://indigenousnations.org
WORDPRESS_API_URL=https://indigenousnations.org/wp-json
WORDPRESS_USERNAME=replace-with-your-wordpress-service-account
WORDPRESS_APPLICATION_PASSWORD=replace-with-your-wordpress-application-password

# Signed webhooks
WORDPRESS_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
PLUGIN_WEBHOOK_SECRET=replace-with-a-second-long-random-webhook-secret
